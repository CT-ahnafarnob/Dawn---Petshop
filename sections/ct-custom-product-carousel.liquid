{{ 'CT-custom.css' | asset_url | stylesheet_tag }}

{% liquid
    assign heading_tag = section.settings.heading_level | default: 'h1'
    assign heading = section.settings.heading
    assign heading_color = section.settings.heading_color
    assign background_color = section.settings.background_color
    assign btn_url = section.settings.btn_url
    assign btn_text = section.settings.btn_text
    assign btn_color = section.settings.btn_color
    assign btn_txt_color = section.settings.btn_txt_color
    assign layout_direction = section.settings.layout_direction
    assign collection = section.settings.selected_collection 
    assign content =  section.settings.content

%}
<style>
    .{{section.id}} {
    background-color: {{background_color}};
    
}
/* Second Section Left */
.{{section.id}} .fourth-sec-heading :is(h1, h2, h3, h4, h5, h6) {
    color: {{heading_color}}; 
    font-size: 60px;
    line-height:1;
    font-weight: 400;
    min-width: 20%;
    margin-bottom: 20px;
    margin-top: 5px;
 
    text-wrap: no-wrap;
} 


/* Fourth section */
.fourth-sec {
  padding: 70px 40px;
}

.fourth-sec-heading {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
}


.fourth-sec-heading p {
  padding: 0 10px;
  font-size: 16px;
  line-height: 1.5;
}

.product-section {
  display: flex;
  justify-content: flex-start;
}

.fourth-sec-left {
  flex-shrink: 0;
  width: 300px;
}

.fourth-sec-right {
  flex: 1;
  min-width: 0;
}

.product-grid__image {
  position: relative;
}

.btn-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  padding: 0;
  opacity: 0;
  transition: all 0.5s ease-in-out;
  color: #fff;
  cursor: pointer;
}

.btn-overlay {
  transform: translateY(50px);
  opacity: 0;
  transition: all 0.4s ease;
  z-index: 10;
}

.product-grid__image:hover .btn-overlay {
  transform: translateY(0);
  opacity: 1;
  z-index: 10;
  cursor: grab;
}
.quick-btn,
.add-cart-btn,
.sold-out {
  width: 100%;
  border-radius: 0;
}

.sold-out {
  background: #ccc;
  color: #666;
}
.product-grid__image img {
  width: 100%;
  max-height: 300px;
}

.demo {
  padding: 0 10px;
  box-sizing: border-box;
}

.btn-fourth {
  width: 88%;
}

.fourth-grid__image {
  width: 100%;
  height: auto;
  /* Maintain aspect ratio */
  max-width: 100%;
  display: block;
}

/* Slick slider */
/* Slick slider */
.{{section.id}} .slick-prev,
.{{section.id}} .slick-next {
  width: 50px !important;
  height: 50px !important;
  z-index: 10 !important;
  display: block !important;
  transform: translateY(-50%) !important;
  position: absolute !important;
}

.{{section.id}} .slick-prev {
  top: 30% !important;
  left: 1% !important;
  right: auto !important;
}

.{{section.id}} .slick-next {
  top: 30% !important;
  right: 1% !important;
  left: auto !important;
}

.{{section.id}} .slick-prev:before,
.{{section.id}} .slick-next:before {
  font-size: 30px !important;
  color: {{btn_color}} !important;
}

.{{section.id}} .slick-prev:hover:before,
.{{section.id}} .slick-next:hover:before {
  color: #f0773f !important;
}

@media (max-width: 998px) {
   .{{section.id}} .fourth-sec-heading :is(h1, h2, h3, h4, h5, h6) {
    min-width: 25%;

} 
}

@media (max-width: 768px) {
  /* Fourth Section */
  .fourth-sec {
    padding: 20px 40px 70px 40px;
  }
  .product-section {
    flex-direction: column;
  }

  .fourth-sec-heading {
    flex-direction: column;
  }

  .{{section.id}} .fourth-sec-heading :is(h1, h2, h3, h4, h5, h6) {
    width: 90%;
    margin: 0;
    padding: 0px;
    flex-shrink: 0;
    text-align: center;
    font-size: 50px;
} 


  .fourth-sec-heading p {
    padding: 0px 20px;
    text-align: justify;
    font-size: 14px;
  }

  .fourth-sec-heading {
    gap: 0;
  }

  .product-section {
    gap: 20px;
  }

  .fourth-sec-left {
    text-align: center;
    width: 100%;
  }

  .fourth-sec-left img {
    width: 80%;
  }

  .btn-fourth {
    width: 80%;
    padding: 5px 10px;
  }
  

}
</style>
<section class="{{section.id}}">
<!-- Second Section -->
      <div class="fourth-sec custom-page-width">
         <div class="fourth-sec-heading">
          {% if heading_tag != blank and  heading == blank %}
                      <{{heading_tag}}>{{collection.title}}</{{heading_tag}}>
                    {% else %}
                      <h1>{{heading}}</h1>
                  {% endif %}
              {% if content != blank %}
           <p>
              {{content}}
            </p> 
            {% endif %}
        </div>
        
        <div class="product-section">
         <div class="fourth-sec-left">
           {% comment %} image {% endcomment %}
                  {% if section.settings.image != blank %}
                      <img src="{{ section.settings.image | image_url }}" alt="" width="100%" height="100%">
                  {% else %}
                    <img src="https://cdn.shopify.com/s/files/1/0941/8362/0977/files/fourth_618578ed-dcdb-4c83-a4e0-6f63153c83c0.png?v=1764102116" 
                    alt="image" width="" height="320px">
            {% endif %}
         
             {% if btn_text != blank and btn_url != blank%}
                    <a class="btn btn-fourth" style="background-color: {{btn_color}}; color:{{btn_txt_color}}" href="{{btn_url}}">{{btn_text}}</a>
                {% endif %}
          </div>

             <div class = "fourth-sec-right">
              {% if collection == blank %}
                                <h1 style="color: #765220; padding: 0 30px;">Please Select A Collection First</h1>
                            {% endif %}
               {% if collection.products.size > 0 %}
                 <div class="demo">
                  {% for product in collection.products %}
                       <div class="product-item">
                             
                              <div class="product-grid__image">
                   
                                    {% if product.featured_image %}
                                
                                      <img
                                              src="{{ product.featured_image | image_url: width: 400 }}"
                                              alt="{{ product.title | escape }}"
                                              width="100%"
                                              height="auto"
                                              loading="lazy"
                                          />
                                    
                                    {% else %}
                                    <div class="product-image-placeholder">No image</div>
                                    {% endif %}



                      {% comment %} Quick Add to Cart {% endcomment %}
                      {% comment %} Add to Cart Button {% endcomment %}
                       <div class="btn-overlay">
                            <a href="{{ product.url }}" class="btn quick-btn">Quick View</a>
                            {% if product.available %}
                                {% if product.has_only_default_variant %}
                                    {% comment %} Single variant - quick add {% endcomment %}
                                    <a 
                                        href="#"
                                        class="btn add-cart-btn"
                                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                                        data-product-title="{{ product.title | escape }}"
                                    >
                                        Add to Cart
                                    </a>
                                {% else %}
                                    {% comment %} Multiple variants - go to product page {% endcomment %}
                                    <a href="{{ product.url }}" class="btn add-cart-btn">
                                        Select Options
                                    </a>
                                {% endif %}
                            {% else %}
                                {% comment %} Sold out {% endcomment %}
                                <a class="btn sold-out" disabled>
                                    Sold Out
                                </a>
                            {% endif %}
                        </div>

                                          {% comment %} 
                                    <div class="btn-overlay">
                                        <a href="{{ product.url }}" class="btn quick-btn">Quick View</a>
                                        <a href="{{ product.url }}?variant={{ product.first_available_variant.id }}" class="btn add-cart-btn" onclick="addToCart(event, '{{ product.first_available_variant.id }}')">Add to Cart</a>
                                        </div> {% endcomment %}
                      
                              </div>
                                <div class="product-grid__title">
                                  <h3> <a href="{{ product.url }}">{{ product.title }}</a></h3>
                                </div>
                                <div class="product-grid__price">
                                  {% if product.compare_at_price > product.price %}
                                    {% comment %} On Sale  {% endcomment %}
                                    <p class="price-sale">{{ product.price | money }}</p>
                                    <p class="price-compare">{{ product.compare_at_price | money }}</p>
                                    {% else %}
                                  {% comment %} Regular Price {% endcomment %}
                                    <p class="price-regular">{{ product.price | money }}</p>
                                  {% endif %}
                                </div>
                          
                        </div>
                 {% endfor %}
                 </div>
            {% endif %}
            </div>
             </div>             
      </div>
</section>

<script>
function addToCart(e, variantId) {
  e.preventDefault();
  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: 1 })
  }).then(() => location.href = '/cart');
}
</script>
 <script defer>
  document.addEventListener('DOMContentLoaded', function() {
    $(".demo").slick({
      infinite: true,
      slidesToShow: 3,
      slidesToScroll: 1,
      arrows: true,
      dots: false,
      adaptiveHeight: true,
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1,
            arrows: true,
            dots: false,
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1,
            arrows: true,
            dots: true,
          },
        },
        {
          breakpoint: 480,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
            dots: true,
          },
        },
      ],
    });
});
</script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.add-cart-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const variantId = this.getAttribute('data-variant-id');
            
            fetch('/cart/add.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: variantId, quantity: 1 })
            })
            .then(response => response.json())
            .then(data => {
                window.location.href = '/cart';
            })
            .catch(error => {
                console.error('Error:', error);
            });
        });
    });
});
</script>
{% schema %}
{
    "name": "Product Carousel",
    "disabled_on": {
      "groups": ["header","footer"]
    },
    "settings": [
        {
            "type": "header",
            "content": "Section Settings"
        },
        {
            "type": "collection",
            "id": "selected_collection",
            "label": "Select Collection" 
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Section background color",
            "default":"#fef6f2"
        },
        {
                "type": "text",
                "id": "heading",
                "label": "Write Heading",
                "default":"Best Sellers"
        },
        {
                "type": "select",
                "id": "heading_level",
                "label": "Heading level",
                "default": "h1",
                "options": 
                [
                    { "value": "h1", "label": "H1" },
                    { "value": "h2", "label": "H2" },
                    { "value": "h3", "label": "H3" },
                    { "value": "h4", "label": "H4" },
                    { "value": "h5", "label": "H5" },
                    { "value": "h6", "label": "H6" }
                ]
        },
        {
                "type": "color",
                "id": "heading_color",
                "label": "Heading color",
                "default":"#765220"
        },
        {   
                "type": "image_picker",
                "id": "image",
                "label": "Change Image"
        },
        {
                "type": "header",  
                "content": "Button Config"

        },
        {
                "type": "text",
                "id": "btn_text",
                "label": "Button Text",
                "default":"Shop Best Sellers"
               
        },
        {
                "type": "color",
                "id": "btn_txt_color",
                "label": "Button Text Color",
                "default":"#ffffff"
        }, 
        {
                "type": "url",
                "id": "btn_url",
                "label": "Button URL"
        },
        {
                "type": "color",
                "id": "btn_color",
                "label": "Button Background Color",
                "default":"#fa9d72"
        },
        {
                "type": "header",
                "content": "Description Typography"
        },
        {
                "type": "richtext",
                "id": "content",
                "label": "Write Description",
                "default":"<p>Take a peek at some of our most popular items! These cute, waterproof bags and accessories are made with the best materials. Our unique designs come in a wide variety of prints and styles, so you can bring your fun fashion sense with you no matter the occasion or give a cute Corgi present to a fellow dog lover!</p>"
        },
        {
                "type": "range",
                "id": "font_size",
                "min": 12,
                "max": 24,
                "step": 1,
                "unit": "px",
                "label": "Font size",
                "default": 20
        },
        {
                "type": "color",
                "id": "rich_text_color",
                "label": "Description text color",
                "default":"#765220"
        },
        {
                "type": "header",  
                "content": "Button Config"

        },
        {
                "type": "select",
                "id": "layout_direction",
                "label": "Layout Direction",
                "options": [
                    { "value": "row", "label": "Image Left, Text Right" },
                    { "value": "row-reverse", "label": "Image Right, Text Left" }
                ],
                "default": "row"
        }      
        ],
        "presets": [
            {
                "name": "CT-Product Carousel",
                "category": "Custom Section"
            }
        ]
}
{% endschema %}